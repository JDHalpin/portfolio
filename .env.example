# Figma API Configuration
# Get your personal access token from: https://www.figma.com/settings
FIGMA_TOKEN=your_figma_token_here

# Figma file ID (from the URL)
# Example URL: https://www.figma.com/design/vFzy38cYS83Xj5CCqdTvi4/...
# File ID: vFzy38cYS83Xj5CCqdTvi4
FIGMA_FILE_ID=vFzy38cYS83Xj5CCqdTvi4
